{
  "name": "yeval-dashboard",
  "version": "1.0.0",
  "description": "Virtual Xbox Controller for PC",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.yeval.dashboard",
    "productName": "Yeval Dashboard",
    "win": {
      "target": "nsis",
      "icon": "../assets/Yeval.svg",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-Setup.exe",
      "installerIcon": "../assets/Yeval.ico",
      "uninstallerIcon": "../assets/Yeval.ico",
      "include": "installer.nsh"
    },
    "extraResources": [
      {
        "from": "../windows/build/Release/MobileControllerBackend.exe",
        "to": "backend/YevalMobileBackend.exe"
      },
      {
        "from": "../assets",
        "to": "assets"
      },
      {
        "from": "prereqs",
        "to": "prereqs"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "31-Gallium",
        "repo": "Yeval"
      }
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.3"
  },
  "author": "31-Gallium",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1"
  }
}
